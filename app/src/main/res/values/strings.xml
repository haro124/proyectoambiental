    <string name="attr_yasuni">Parque Yasuní</string>
    <string name="attr_yasuni_desc">Área protegida de increíble biodiversidad en la Amazonía ecuatoriana. Hogar de cientos de especies endémicas.</string>
    <string name="attr_napo">Río Napo</string>
    <string name="attr_napo_desc">Importante afluente amazónico que atraviesa la provincia de Orellana. Ideal para navegación y avistamiento de fauna.</string>
    <string name="attr_cascada">Cascada La Belleza</string>
    <string name="attr_cascada_desc">Impresionante caída de agua rodeada de vegetación exuberante. Destino perfecto para ecoturismo y fotografía.</string>

    <string name="species_parrot">Loro Amazónico</string>
    <string name="species_parrot_sci">Amazona ochrocephala</string>
    <string name="species_parrot_desc">Especie emblemática de la Amazonía ecuatoriana. Se encuentra en bordes de bosque y áreas riparias.</string>
    <string name="species_jaguar">Jaguar</string>
    <string name="species_jaguar_sci">Panthera onca</string>
    <string name="species_jaguar_desc">El felino más grande de América. Depredador tope en los ecosistemas amazónicos de Orellana.</string>
    <string name="species_ceibo">Ceibo</string>
    <string name="species_ceibo_sci">Ceiba pentandra</string>
    <string name="species_ceibo_desc">Árbol emblemático de la Amazonía, de hasta 70 metros de altura. Sagrado para las culturas amazónicas.</string>

    <string name="community_waorani">Comunidad Waorani</string>
    <string name="community_waorani_desc">Habitantes ancestrales del Yasuní. Conocidos por su profundo conocimiento del bosque y su resistencia cultural.</string>
    <string name="community_shuar">Comunidad Shuar</string>
    <string name="community_shuar_desc">Pueblo indígena conocido por su tradición guerrera y su relación espiritual con la selva. Expertos en tejido y cerámica.</string>
    <string name="community_kichwa">Comunidad Kichwa</string>
    <string name="community_kichwa_desc">La comunidad más numerosa de la Amazonía. Reconocidos por su música, medicina ancestral y gastronomía.</string>

