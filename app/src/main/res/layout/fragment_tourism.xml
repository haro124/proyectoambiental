<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_forest"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/forest_green"
        app:navigationIcon="@drawable/ic_leaf"
        app:navigationIconTint="@color/light_green"
        app:title="@string/tourism_title"
        app:titleTextColor="@color/pale_green" />

    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp">

        <EditText
            android:id="@+id/searchEdit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:drawablePadding="12dp"
            android:drawableStart="@drawable/ic_compass"
            android:hint="@string/home_search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

    </androidx.cardview.widget.CardView>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        app:chipSpacing="8dp"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAll"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:checked="true"
            android:text="@string/filter_all"
            android:textColor="@color/soft_green"
            android:textSize="12sp"
            app:chipBackgroundColor="@color/chip_bg"
            app:chipCornerRadius="15dp"
            app:chipMinHeight="30dp"
            app:chipStrokeColor="@color/card_border"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRivers"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/filter_rivers"
            android:textColor="@color/river_blue"
            android:textSize="12sp"
            app:chipBackgroundColor="@color/chip_bg"
            app:chipCornerRadius="15dp"
            app:chipMinHeight="30dp"
            app:chipStrokeColor="@color/card_border"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipForest"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/filter_forest"
            android:textColor="@color/light_green"
            android:textSize="12sp"
            app:chipBackgroundColor="@color/chip_bg"
            app:chipCornerRadius="15dp"
            app:chipMinHeight="30dp"
            app:chipStrokeColor="@color/card_border"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCultural"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/filter_cultural"
            android:textColor="@color/natural_yellow"
            android:textSize="12sp"
            app:chipBackgroundColor="@color/chip_bg"
            app:chipCornerRadius="15dp"
            app:chipMinHeight="30dp"
            app:chipStrokeColor="@color/card_border"
            app:chipStrokeWidth="1dp" />
    </com.google.android.material.chip.ChipGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAttractions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>
